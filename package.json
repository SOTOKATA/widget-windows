{
  "name": "widget-windows",
  "version": "1.2.4",
  "description": "Simple widget app to manage personal todos.",
  "main": "./out/main/index.js",
  "author": "sotok14.com",
  "homepage": "https://electron-vite.org",
  "scripts": {
    "dist": "electron-vite build && electron-builder --win",
    "format": "prettier --plugin prettier-plugin-svelte --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "svelte-check": "svelte-check --tsconfig ./tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run svelte-check",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "electron-vite build && electron-builder --win",
    "publish:win": "electron-vite build && electron-builder --win nsis --publish always"
  },
  "build": {
    "appId": "com.sotok14.todowidget",
    "productName": "Todos Widget",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "package.json",
      "!src/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "SOTOKATA",
        "repo": "widget-windows"
      }
    ]
  },
  "dependencies": {
    "@appulsauce/svelte-grid": "^2.2.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/view": "^6.43.15",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@lezer/highlight": "^1.2.5",
    "@lucide/svelte": "^1.70.0",
    "@tursodatabase/sync": "^0.8.3",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.18",
    "electron-log": "^5.4.4",
    "electron-store": "^12.0.0",
    "electron-updater": "^6.8.11",
    "esrap": "^2.4.0",
    "koffi": "^3.3.7",
    "marked": "^18.2.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/marked": "^6.0.0",
    "@types/node": "^24.19.2",
    "daisyui": "^5.7.50",
    "electron": "^44.7.2",
    "electron-builder": "^26",
    "electron-vite": "^6.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-svelte": "^3.23.1",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "sveltekit-superforms": "^3.1.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "zod": "^4.6.7"
  }
}
